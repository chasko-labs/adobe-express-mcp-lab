{
  "testId": "hello-world",
  "name": "Hello World (MCP Grounded)",
  "version": "1.0.0",
  "manifestVersion": 2,
  "requirements": {
    "apps": [{ "name": "Express", "apiVersion": 1 }],
    "supportsTouch": false
  },
  "entryPoints": [
    {
      "type": "panel",
      "id": "hello-world",
      "main": "index.html",
      "documentSandbox": "code.js",
      "permissions": {
        "sandbox": ["allow-popups", "allow-presentation", "allow-downloads"]
      }
    }
  ]
}
