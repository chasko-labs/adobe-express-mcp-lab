{
  "testId": "firefly-tic-tac-toe",
  "name": "Firefly Tic-Tac-Toe — Sumerian Squares (Generative)",
  "version": "0.1.0",
  "manifestVersion": 2,
  "requirements": {
    "apps": [{ "name": "Express", "apiVersion": 1 }],
    "supportsTouch": false
  },
  "entryPoints": [
    {
      "type": "panel",
      "id": "firefly-tic-tac-toe",
      "main": "index.html",
      "documentSandbox": "code.js",
      "permissions": {
        "sandbox": ["allow-popups", "allow-presentation", "allow-downloads"]
      }
    }
  ]
}
